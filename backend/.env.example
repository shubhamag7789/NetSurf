# Netsurf Backend Environment Configuration
# Copy this file to .env (or backend/.env) to configure real API providers.
# Secrets should NEVER be committed to version control.

# ── 1. Gemini AI (Google AI Studio) ─────────────────────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
# Recommended models: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro, gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# ── 2. Web Search — Tavily ──────────────────────────────────────────────────
# Get free API key: https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ── 3. Optional Alternatives (Anthropic / Brave) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# BRAVE_SEARCH_API_KEY=bsk-your-key-here

# ── 4. Server Ports ────────────────────────────────────────────────────────
PORT=3000
DEMO_SITE_PORT=3001
NODE_ENV=development

# ── 5. Playwright Browser Controls ──────────────────────────────────────────
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000
MAX_RETRIES=2

# ── 6. Safety & Sandbox Policies ───────────────────────────────────────────
# Sandboxed origin for local test store Playwright automation
ALLOWED_ORIGINS=http://localhost:3001

# Comma-separated actions requiring explicit user confirmation
APPROVAL_REQUIRED_ACTIONS=submit_form,purchase,delete,send_message

# ── 7. Storage & Memory ────────────────────────────────────────────────────
MEMORY_ENABLED=true
DB_PATH=./netsurf.db
